# Copy to backend/.env and edit.

# --- AI (optional) ---
# Your own Anthropic key. Without it the AI panel shows "not configured" and
# everything else keeps working.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-5

# --- Pro tokens ---
# Set this to keep issued Pro tokens valid across restarts.
PRO_SECRET=change-me-to-a-long-random-string
# REDEEM_CODES=VIDEO-PRO-2026,STUDENT-VIP,KIRO-UNLOCK
# PRO_TOKEN_TTL_DAYS=30

# --- Limits ---
# FREE_MAX_HEIGHT=720
# PRO_MAX_HEIGHT=2160
# FREE_BATCH_LIMIT=1
# PRO_BATCH_LIMIT=20
# MAX_FILESIZE_MB=2048
# MAX_DURATION_SECONDS=14400
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_SECONDS=300
# MAX_WORKERS=4
# JOB_TTL_SECONDS=3600

# --- Sites needing login ---
# Netscape-format cookies.txt ONLY. A JSON cookie export will be rejected.
# COOKIE_FILE=/path/to/cookies.txt

# --- Networking ---
# CORS_ORIGINS=http://localhost:3000

# DEV ONLY. Leave unset in production.
# Needed only where DNS maps public sites into ranges Python calls private
# (this dev sandbox resolves youtube.com into 198.18.0.0/15, RFC 2544).
# ALLOW_RESOLVED_NETS=198.18.0.0/15
